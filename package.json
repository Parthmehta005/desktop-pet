{
  "name": "desktop-pet",
  "version": "0.1.0",
  "private": true,
  "description": "A Windows desktop pet that walks along your taskbar and reacts to your coding and to Claude Code.",
  "type": "module",
  "main": "src/main/main.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "electron .",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "preview": "node scripts/preview-server.js",
    "test:browser": "playwright test --trace off",
    "test:electron": "node scripts/run-electron-tests.js",
    "test:all": "npm run lint && npm test && npm run test:browser && npm run test:electron",
    "build:icons": "node scripts/build-icons.js",
    "hooks:install": "node scripts/hooks.js install",
    "hooks:uninstall": "node scripts/hooks.js uninstall",
    "hooks:status": "node scripts/hooks.js status"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "electron": "45.5.0",
    "eslint": "10.15.0",
    "globals": "17.14.0"
  },
  "dependencies": {
    "chokidar": "4.0.3"
  }
}
